<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <link href="~/Stylesheet.css" rel="stylesheet" />
</head>
<body>

    <div class="container">
        <div class="navbar">
            <div class="navbar-brand">
                <img src="~/Mylogo.png" width="30px" asp-append-version="true" />
            </div>

            <ul>

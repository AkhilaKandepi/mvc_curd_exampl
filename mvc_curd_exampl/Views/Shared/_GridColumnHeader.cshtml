@if (ViewBag.CurrentSortBy == ViewBag.ColumnName && ViewBag.CurrentSortOrder == SortOrderOptions.ASC.ToString())
{
 <th>
        <a href="~/Person/DisplayPersonData?DropdownItems=@(ViewBag.CurrentSearchBy)&serachstring=@(ViewBag.CurrentSearchString)&sortedby=@(ViewBag.ColumnName)&sortorder=@(nameof(SortOrderOptions.DESC))">@ViewBag.DisplayName</a>
  <i class="fa-solid fa-sort-up"></i>
 </th>
}
else if (ViewBag.CurrentSortBy == nameof(PersonResponce.PersonName) && ViewBag.CurrentSortOrder == SortOrderOptions.DESC.ToString())
{
 <th>
        <a href="~/Person/DisplayPersonData?DropdownItems=@(ViewBag.CurrentSearchBy)&serachstring=@(ViewBag.CurrentSearchString)&sortedby=@(ViewBag.ColumnName)&sortorder=@(nameof(SortOrderOptions.ASC))">@ViewBag.DisplayName</a>
  <i class="fa-solid fa-sort-down"></i>
 </th>
}
else
{
 <th>
        <a href="~/Person/DisplayPersonData?DropdownItems=@(ViewBag.CurrentSearchBy)&serachstring=@(ViewBag.CurrentSearchString)&sortedby=@(ViewBag.ColumnName)&sortorder=@(nameof(SortOrderOptions.ASC))">@ViewBag.DisplayName</a>
 </th>
}
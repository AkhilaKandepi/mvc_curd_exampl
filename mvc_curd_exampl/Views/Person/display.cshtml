@model ServiceContract.DTO.PersonResponce

<!DOCTYPE html>
<html>
<head>
    <title>Person Details</title>
</head>
<body>

    <h1>Person Details</h1>

    <h3>Person ID : @Model.PersonId</h3>
    <h3>Person Name : @Model.PersonName </h3>

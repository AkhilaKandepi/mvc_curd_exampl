@model PersonUpdateRequest

<h1> edit</h1>

<a asp-controller="Person" asp-action="DisplayPersonData" class="link-hover"> Back to List </a>

<form asp-controller="Person" asp-action="UpdatePerson" method="post">

    <input  type="hidden" asp-for="PersonId" />


    <div class="form-field flex">

        <div class="w-25">
            <label asp-for="PersonName" class="form-label pt">Person Name</label>
        </div>


        <div class="flex-1">
            <input asp-for="PersonName" class="form-input" />
        </div>


    </div>


    <div class="form-field flex">

        <div class="w-25">
            <label asp-for="PersonEmail" class="form-label pt"> Person Email</label>
        </div>

        <div class="flex-1">
           
            <input  asp-for="PersonEmail" class="form-input"/>
        </div>

    </div>

     <div class="form-field flex">
         <div class="w-25">
             <label asp-for="Gender" class="form-label pt">gender</label>

         </div>
         <div class="flex-1">
             <input asp-for="Gender" class="form-input" />

         </div>

     </div>


    <div class="form-field flex">
        <div class="w-25">
            <label asp-for="BloodGroup" class="form-label pt">Blood Group</label>

        </div>
        <div class="flex-1">
            <input asp-for="BloodGroup" class="form-input" />

        </div>

    </div>

    <div class="form-field flex">

        <div class="w-25">
            <label asp-for="Country" class="form-label pt">Country Name</label>
        </div>
        <div class="flex-1">
        <select asp-for="CountryId"
                asp-items="ViewBag.AllCountrydata"
                 class="form-input">

        <option value= ""> 
            ------- select country name --------
        </option>
           </select>
        </div>
       

    </div>

    <div class="form-field flex">
        <div class="w-25">
            <label asp-for="Address" class="form-label pt">Address</label>
        </div>
        <div class="flex-1">
   <textarea asp-for="Address" class="form-input"></textarea>
        </div>
    </div>

    <div class="form-field flex">
        <div class="w-25">
            <label asp-for="DateOfBirth" class="form-label pt">Date of Birth</label>
        </div>
        <div class="flex-1">
            <input type="date" asp-for="DateOfBirth" class="form-input" />
            
        </div>
    </div>
    <div class="form-field flex">
        <div class="w-25">
        </div>
        <div class="flex-1">
            <input asp-for="ReceiveNewsLetters" value="true" />
            <label asp-for="ReceiveNewsLetters" class="form-label">Receive News Letters</label>
        </div>
    </div>

    <div class="form-field flex">
        <div class="w-25">
        </div>
        <div class="flex-1">
            <button class="button button-green-back">Update</button>
        </div>
        </div>


   



</form>
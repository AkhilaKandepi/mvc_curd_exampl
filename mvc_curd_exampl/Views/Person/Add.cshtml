@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ServiceContract.DTO.PersonAddRequest


 
<!DOCTYPE html>
<html>
<head>
<title>Add Person</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
 
    <h1>Add Person</h1>
    <div class="center-box">
    <form asp-controller="Person" asp-action="Add" method="post">
      <div class="form-field flex">
                <div class="w-25">
                    <label asp-for="PersonName" class="form-label pt">Person Name</label>
                </div>
                <div class="flex-1">
                    <input asp-for="PersonName" class="form-input" />
                </div>
          
         </div>
 



        <label>Person Email</label><br />
<input asp-for="PersonEmail" />
<br /><br />
 
        <label>Date of Birth</label><br />
<input asp-for="DateOfBirth" type="date" />
<br /><br />
 
        <label>Gender</label><br />
<input asp-for="Gender" />
<br /><br />
 
        <label>Country</label><br />
        <select name="Countyid" id="Countyid" asp-items="@ViewBag.ALLCountryData_viewbag">
            <option value=""> -- Please select Country --</option>

          
    </select>

<br /><br />
 
        <label>Address</label><br />
<input asp-for="Address" />
<br /><br />
 
        <label>Receive News Letters</label>
<input asp-for="ReceiveNewsLetters" />
<br /><br />
<label>BLOODGROUP</label><br />
<input asp-for=BloodGroup />
<br />
 
        <button type="submit">Submit</button>
 
    </form>

    </div>
 
</body>
</html>
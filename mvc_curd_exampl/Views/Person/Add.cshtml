@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ServiceContract.DTO.PersonAddRequest


 
<!DOCTYPE html>
<html>
<head>
<title>Add Person</title>
    <link href="~/StyleSheet.css" rel="stylesheet" />
</head>
<body>
 
    <h1>Add Person</h1>
    <div class="center-box">
    <form asp-controller="Person" asp-action="Add" method="post">
      <div class="form-field flex">
                <div class="w-25">
                    <label asp-for="PersonName" class="form-label pt">Person Name</label>
                </div>
                <div class="flex-1">
                    <input asp-for="PersonName" class="form-input" />
                </div>
          
         </div>


          <div class="form-field flex">
           
                     <div class="w-25">

                           <label asp-for="PersonEmail" class="form-label pt">Person Email</label><br />
                   </div>
       
                   <div class="flex-1">
                         <input asp-for="PersonEmail" class="form-input" />


                      </div>

         </div>

         <div class="form-field flex">

               <div class="w-25">
                    <label asp-for="DateOfBirth" class="form-label pt">Date of Birth</label><br />

               </div>
               <div class="flex-1">
                 <input  asp-for="DateOfBirth" class="form-input"/>

              </div>
         </div>


         <div class="form-field flex">
             <div class="w-25">
                 <label class="form-label" asp-for="Country">Country</label>

             </div>
             <div class="flex-1">
                    <select asp-for="Country" class="form-input" asp-items="@ViewBag.ALLCountryData_viewbag">
                        <option value="">Please Select</option>

                 </select>

             </div>
         </div>

       
            <div class="form-field flex">
                <div class="w-25">
                    <label asp-for="Address" class="form-label pt">Address</label>
                </div>
                <div class="flex-1">
            <textarea asp-for="Address" class="form-input"></textarea>
                 <span asp-validation-for="Address" class="text-red"></span>
                </div>
            </div>



            <div class="form-field flex">
                <div class="w-25">

                    <label asp-for="ReceiveNewsLetters" class="form-label">Receive News Letters</label>
                </div>
                <div class="flex-1">
                    <input asp-for="ReceiveNewsLetters" value="true" />

                    <span asp-validation-for="ReceiveNewsLetters" class="text-red"></span>
                </div>
            </div>

           
            <div class="form-field flex">
             <div class="w-25">
                <label asp-for="BloodGroup">BLOODGROUP</label>
              </div>
              <div  class="flex-1">
                    <input asp-for=BloodGroup class="form-input" />
              </div>

            </div>

            <div class="form-field flex">

                <div class="w-25">
                    <label>Gender</label>

                </div>
                  

                <div class="flex-1" >
                    <input asp-for="Gender" />


                </div>
  



            </div>


            @*   <div class="form-field flex">
                <div class="w-25">
                </div>
                <div class="flex-1">
                    <button class="button button-green-back">Create</button>

                    <div asp-validation-summary="All" class="text-red"></div>

                    @if (ViewBag.Errors != null)
                    {
                        <div class="text-red ml">
                     z       <ul>
                                @foreach (string error in ViewBag.Errors)
                                {
                                    <li class="ml">@error</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>

 *@







 
        <button type="submit">Submit</button>
 
    </form>

    </div>
 
</body>
</html>